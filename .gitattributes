# 统一换行符：仓库内一律 LF，避免 Windows 构建机的 CRLF 污染 diff
* text=auto eol=lf

# 二进制资源，禁止任何文本转换
*.png  binary
*.ico  binary
*.jpg  binary
*.icns binary
*.exe  binary
*.dll  binary
*.zip  binary
*.dmg  binary
*.deb  binary
*.ttf  binary
*.pem  binary
*.der  binary

# 批处理/命令脚本保留 CRLF，否则 Windows 上 cmd 解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
