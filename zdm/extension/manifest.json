{
  "manifest_version": 3,
  "name": "ZDM Connector",
  "version": "1.2.1",
  "description": "接管浏览器下载，交给本机 ZDM 多线程下载器加速；ZDM 没开着会自动唤醒它",
  "minimum_chrome_version": "100",
  "key": "",
  "permissions": [
    "downloads",
    "downloads.open",
    "contextMenus",
    "storage",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": ["http://127.0.0.1:*/", "http://localhost:*/"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ZDM 下载管理器",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
