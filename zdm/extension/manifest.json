{
  "manifest_version": 3,
  "name": "ZDM Connector",
  "version": "1.5.11",
  "description": "接管浏览器下载、嗅探网页视频音频并一键推送给本机 ZDM 多线程下载器；B站/YouTube 视频卡片上悬浮显示「下载此视频」并可选清晰度；ZDM 没开着会自动唤醒它",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "downloads",
    "downloads.open",
    "contextMenus",
    "storage",
    "notifications",
    "nativeMessaging",
    "webRequest",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/",
    "http://localhost:*/",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "sniffer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.bilivideo.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "js": [
        "videobtn.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ZDM 下载管理器",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sites.js"
      ],
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.bilivideo.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ]
    }
  ]
}
