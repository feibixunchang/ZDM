# WorkBuddy 会话数据
.workbuddy/
.Trash-0/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
env/

# 下载中间产物
*.part
*.part.zdm

# 桌面端运行时诊断日志（Dock 唤醒等排障用）
dock.log
gui.log
zdm.log

# 构建中间目录
dist/deb_staging/
dist/zdm-linux/
dist/zdm-macos/
dist/zdm-windows/
.build_win/

# 构建产物：.deb / tarball / .exe 由 CI（GitHub Actions）产出并挂到 Release，
# 不入库，避免仓库里堆积同名的历史版本。
dist/*.deb
dist/*.tar.gz
dist/*.exe

# 随包的 yt-dlp 单文件二进制（约 35MB）与旧的 pip 包目录：由构建脚本/CI 按
# 固定版本下载，不入库，避免仓库被二进制撑爆。
zdm/bin/
zdm/zdm/yt_dlp_pkg/

# 系统
.DS_Store
Thumbs.db
