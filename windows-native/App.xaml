<Application x:Class="Zdm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Zdm.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- bool -> Visibility, used to show hints only for matching rows -->
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!--
                Font choice matters: "Microsoft YaHei UI" is the CJK-optimised UI
                face Windows ships, and WPF renders it through DirectWrite with
                ClearType, matching Explorer and Settings exactly. Do not switch
                to a raster-ish fallback - that reintroduces the rough look.
            -->
            <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
            <sys:Double x:Key="UiFontSize">13</sys:Double>

            <!--
                Colour keys are placeholders only. ThemeManager.Apply() replaces
                every one of them at runtime with the active palette, so all
                styles use DynamicResource and repaint on a theme switch. Never
                write a literal colour into a control: that is what leaves light
                fragments on a dark background.
            -->
            <SolidColorBrush x:Key="AppBg" Color="#f5f7fa"/>
            <SolidColorBrush x:Key="Surface" Color="#ffffff"/>
            <SolidColorBrush x:Key="SurfaceAlt" Color="#fafbfc"/>
            <SolidColorBrush x:Key="HoverBg" Color="#f3f4f6"/>
            <SolidColorBrush x:Key="PressedBg" Color="#e8ecf1"/>
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#e3e8ef"/>
            <SolidColorBrush x:Key="BorderSoft" Color="#f1f3f7"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#1f2937"/>
            <SolidColorBrush x:Key="TextMuted" Color="#6b7280"/>
            <SolidColorBrush x:Key="TextStrong" Color="#374151"/>
            <SolidColorBrush x:Key="Accent" Color="#2563eb"/>
            <SolidColorBrush x:Key="AccentHover" Color="#1d4fd8"/>
            <SolidColorBrush x:Key="AccentPressed" Color="#1a45bf"/>
            <SolidColorBrush x:Key="AccentSoft" Color="#eff4ff"/>
            <SolidColorBrush x:Key="AccentSoftBorder" Color="#c7d7fe"/>
            <SolidColorBrush x:Key="AccentText" Color="#ffffff"/>
            <SolidColorBrush x:Key="Track" Color="#e8ecf1"/>
            <SolidColorBrush x:Key="Selection" Color="#eff4ff"/>
            <SolidColorBrush x:Key="SelectionText" Color="#1f2937"/>
            <SolidColorBrush x:Key="StatusDownloading" Color="#2563eb"/>
            <SolidColorBrush x:Key="StatusCompleted" Color="#16a34a"/>
            <SolidColorBrush x:Key="StatusPaused" Color="#d97706"/>
            <SolidColorBrush x:Key="StatusError" Color="#dc2626"/>
            <SolidColorBrush x:Key="StatusQueued" Color="#94a3b8"/>
            <SolidColorBrush x:Key="StatusMerging" Color="#7c3aed"/>

            <!-- Scrollbars: slim, themed, unobtrusive -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BorderBrushSoft}"/>
            </Style>

            <Style TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>

            <Style TargetType="Thumb">
                <Setter Property="Background" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4" Margin="2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Radio buttons in the settings dialog -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Dot" Width="15" Height="15"
                                        CornerRadius="8" Margin="0,0,7,0"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1.5"
                                        Background="{DynamicResource Surface}">
                                    <Ellipse x:Name="Inner" Width="7" Height="7"
                                             Fill="{DynamicResource Accent}"
                                             Visibility="Collapsed" HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot" Property="BorderBrush"
                                            Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="BorderBrush"
                                            Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text inputs -->
            <Style x:Key="AppTextBox" TargetType="TextBox">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <!--
                                  Margin carries the padding, not the ScrollViewer:
                                  padding inside a ScrollViewer is applied after
                                  layout and can clip the glyphs vertically.
                                -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat toolbar / secondary button -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter Property="Padding" Value="18,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="FilterTab" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Column headers must also resolve colour dynamically. -->
            <Style TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource GridHeader}"/>

            <Style x:Key="GridCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                DataGrid's stock template paints rows with the system window
                brush, which stays light in dark mode. Pin both the row and
                alternate-row brushes to themed resources so the whole grid
                flips together.
            -->
            <Style TargetType="DataGrid">
                <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface}"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            </Style>

            <!--
                DataGridRow needs its own template: the default one paints an
                opaque white background, which survives a theme switch and leaves
                a bright block on a dark surface.

                CellsPresenter is not a public element, so the row is themed
                through the cell template plus Background/Foreground, which is
                enough here because every cell renders through GridCell.
            -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Selection}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Cell background is transparent so the themed row shows through. -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <!-- Context menu / popup surfaces follow the theme too -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="6,4"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Popup itself has no Background; the themed surface is applied by
                the ContextMenu / ComboBox templates that live inside it, so
                drop-down lists already follow the palette.
            -->

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>